  "grammar": {
    "intro": "Un verbo itza' se arma con piezas: a veces una palabra auxiliar, un marcador de aspecto, un prefijo de persona, el verbo y un sufijo de estatus. Para buscar un verbo, escríbelo como en el diccionario: wenel «dormir», ilik «ver».",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Auxiliar",
            "description": "Palabra opcional que agrega un sentido: k'ab'et «necesitar», tak «querer».",
            "example": "k'ab'et"
          },
          {
            "slot": "Aspecto",
            "description": "Cuándo o cómo pasa la acción: k- costumbre, tan ahora.",
            "example": "k-"
          },
          {
            "slot": "Persona (juego A)",
            "description": "Quién hace la acción.",
            "example": "in-"
          },
          {
            "slot": "Verbo",
            "description": "La raíz.",
            "example": "wen"
          },
          {
            "slot": "Estatus",
            "description": "Sufijo que cambia con el aspecto: -el, -ik, -aj…",
            "example": "-el"
          },
          {
            "slot": "Plural",
            "description": "-e'ex para «ustedes», -o' para «ellos».",
            "example": "-o'"
          }
        ]
      },
      {
        "type": "table",
        "title": "Dos juegos de marcadores de persona",
        "description": "El juego A va antes del verbo; el juego B, después. Ante vocal, el juego A agrega w o y: in-w-il, u-y-il.",
        "columns": [
          "Persona",
          "Juego A",
          "Juego B"
        ],
        "rows": [
          {
            "label": "yo",
            "cells": [
              "in(w)-",
              "-en"
            ]
          },
          {
            "label": "tú",
            "cells": [
              "a(w)-",
              "-ech"
            ]
          },
          {
            "label": "él, ella",
            "cells": [
              "u(y)-",
              "-ij, -Ø"
            ]
          },
          {
            "label": "nosotros",
            "cells": [
              "ki(w)-",
              "-o'on"
            ]
          },
          {
            "label": "ustedes",
            "cells": [
              "a(w)- … -e'ex",
              "-e'ex"
            ]
          },
          {
            "label": "ellos, ellas",
            "cells": [
              "u(y)- … -o'",
              "-o'"
            ]
          }
        ],
        "note": "«Nosotros» con -e'ex al final incluye a quien escucha: kiwenele'ex «todos dormimos»."
      },
      {
        "type": "pairs",
        "title": "En el pasado, la persona cambia de lugar",
        "description": "En el presente, el juego A marca a quien hace la acción en todos los verbos. En el pasado, los verbos intransitivos usan el juego B al final.",
        "items": [
          {
            "text": "kinwenel",
            "translation": "duermo"
          },
          {
            "text": "wenen",
            "translation": "dormí"
          },
          {
            "text": "kinwilik",
            "translation": "lo veo"
          },
          {
            "text": "tinwilaj",
            "translation": "lo vi"
          }
        ]
      },
      {
        "type": "cards",
        "title": "Tres tipos de verbo",
        "items": [
          {
            "tag": "-Vl",
            "name": "Intransitivo",
            "description": "No lleva objeto. Su sufijo repite la vocal de la raíz: wen-el, jok'-ol, nak'-äl.",
            "examples": [
              {
                "from": "wenel",
                "to": "wenen",
                "meaning": "dormí"
              },
              {
                "from": "k'ochol",
                "to": "k'ochen",
                "meaning": "llegué"
              }
            ]
          },
          {
            "tag": "-ik",
            "name": "Transitivo de raíz",
            "description": "Lleva objeto. En el pasado toma t- y -aj.",
            "examples": [
              {
                "from": "ilik",
                "to": "tinwilaj",
                "meaning": "lo vi"
              },
              {
                "from": "uk'ik",
                "to": "tinwuk'aj",
                "meaning": "lo bebí"
              }
            ]
          },
          {
            "tag": "-tik",
            "name": "Transitivo con -t",
            "description": "La -t- forma verbos transitivos. En el perfecto la -t- cambia por -m-.",
            "examples": [
              {
                "from": "jantik",
                "to": "tinjantaj",
                "meaning": "lo comí"
              },
              {
                "from": "jantik",
                "to": "injanmaj",
                "meaning": "lo he comido"
              }
            ]
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Palabras auxiliares",
        "description": "Van antes del verbo, que conserva su prefijo de persona y su sufijo -Vl o -ik, sin k-.",
        "items": [
          {
            "text": "k'ab'et inwenel",
            "translation": "necesito dormir"
          },
          {
            "text": "tak inwenel",
            "translation": "quiero dormir"
          },
          {
            "text": "yan inwenel",
            "translation": "tengo que dormir"
          },
          {
            "text": "patal inwenel",
            "translation": "puedo dormir"
          },
          {
            "text": "suk inwenel",
            "translation": "suelo dormir"
          },
          {
            "text": "olak inwenel",
            "translation": "casi dormí"
          },
          {
            "text": "kajij inwenel",
            "translation": "empecé a dormir"
          },
          {
            "text": "ts'o'kij inwenel",
            "translation": "ya dormí"
          }
        ]
      },
      {
        "type": "cards",
        "title": "Los modos: estatus dependiente",
        "description": "Para lo que todavía no es real (deseos, órdenes, advertencias), el verbo toma el estatus dependiente: -Vk en los intransitivos y -V' o -ej en los transitivos.",
        "items": [
          {
            "tag": "ka'",
            "name": "Subjuntivo",
            "description": "«Que…»: lo que puede o no pasar.",
            "examples": [
              {
                "from": "wenel",
                "to": "ka' wenekech",
                "meaning": "que duermas"
              },
              {
                "from": "uk'ik",
                "to": "ka' uyuk'u'",
                "meaning": "que lo beba"
              }
            ]
          },
          {
            "tag": "-en / -V'",
            "name": "Imperativo",
            "description": "Órdenes. En negativo se usa ma' con el presente.",
            "examples": [
              {
                "from": "wenel",
                "to": "wenen!",
                "meaning": "¡duerme!"
              },
              {
                "from": "wenel",
                "to": "ma' awenel",
                "meaning": "¡no duermas!"
              }
            ]
          },
          {
            "tag": "b'ikij",
            "name": "Advertencia",
            "description": "Avisa de algo que podría pasar.",
            "examples": [
              {
                "from": "lub'ul",
                "to": "b'ikij lub'ukech",
                "meaning": "¡cuidado, te puedes caer!"
              }
            ]
          },
          {
            "tag": "ko'ox",
            "name": "Exhortativo",
            "description": "«Vamos a…». Con ko'on, «ven a…».",
            "examples": [
              {
                "from": "wenel",
                "to": "ko'ox ti wenel",
                "meaning": "vamos a dormir"
              },
              {
                "from": "ilik",
                "to": "ko'ox kiwila'",
                "meaning": "vamos a verlo"
              }
            ]
          }
        ]
      },
      {
        "type": "pairs",
        "title": "La negación: ma'",
        "description": "Para negar el presente se usa tan, el marcador de lo que está pasando.",
        "items": [
          {
            "text": "ma' tan inwenel",
            "translation": "no duermo"
          },
          {
            "text": "ma' wenij",
            "translation": "no durmió"
          },
          {
            "text": "ma' tinwilaj",
            "translation": "no lo vi"
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Frases de ejemplo",
        "items": [
          {
            "text": "K'ochen b'iyernes.",
            "translation": "Llegué el viernes."
          },
          {
            "text": "Tan uyok'ol a' miso'ej.",
            "translation": "Los gatos están maullando."
          },
          {
            "text": "Tuyilajo' juntul ajchab'.",
            "translation": "Miraron un oso hormiguero."
          },
          {
            "text": "Wi'ijen.",
            "translation": "Tengo hambre."
          },
          {
            "text": "Je' imb'elej!",
            "translation": "¡Sí voy!"
          }
        ]
      },
      {
        "type": "affixes",
        "title": "Todos los afijos del verbo",
        "description": "Cada pieza que un verbo puede llevar: prefijos, sufijos, partículas y cambios de raíz.",
        "items": [
          {
            "affix": "k-",
            "kind": "aspecto",
            "meaning": "Incompletivo: costumbre, lo que pasa siempre",
            "example": "kinwenel",
            "translation": "duermo"
          },
          {
            "affix": "tan",
            "kind": "aspecto",
            "meaning": "Durativo: lo que está pasando",
            "example": "tan inwenel",
            "translation": "estoy durmiendo"
          },
          {
            "affix": "kil … -ej",
            "kind": "aspecto",
            "meaning": "Puntual: «cuando…»",
            "example": "kil inwenelej",
