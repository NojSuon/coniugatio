  "grammar": {
    "intro": "Un verbo itza' se arma con piezas: un marcador de aspecto, un prefijo de persona, el verbo y un sufijo de estatus. Para buscar un verbo, escríbelo como en el diccionario: wenel «dormir», ilik «ver».",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Aspecto",
            "description": "Cuándo o cómo pasa la acción: k- costumbre, tan ahora.",
            "example": "k-"
          },
          {
            "slot": "Persona (juego A)",
            "description": "Quién hace la acción.",
            "example": "in-"
          },
          {
            "slot": "Verbo",
            "description": "La raíz.",
            "example": "wen"
          },
          {
            "slot": "Estatus",
            "description": "Sufijo que cambia con el aspecto: -el, -ik, -aj…",
            "example": "-el"
          },
          {
            "slot": "Plural",
            "description": "-e'ex para «ustedes», -oo' para «ellos».",
            "example": "-oo'"
          }
        ]
      },
      {
        "type": "table",
        "title": "Dos juegos de marcadores de persona",
        "description": "El juego A va antes del verbo; el juego B, después. Ante vocal, el juego A agrega w o y: in-w-il, u-y-il.",
        "columns": [
          "Persona",
          "Juego A",
          "Juego B"
        ],
        "rows": [
          {
            "label": "yo",
            "cells": [
              "in(w)-",
              "-en"
            ]
          },
          {
            "label": "tú",
            "cells": [
              "a(w)-",
              "-ech"
            ]
          },
          {
            "label": "él, ella",
            "cells": [
              "u(y)-",
              "-ij, -Ø"
            ]
          },
          {
            "label": "nosotros",
            "cells": [
              "ki(w)-",
              "-o'on"
            ]
          },
          {
            "label": "ustedes",
            "cells": [
              "a(w)- … -e'ex",
              "-e'ex"
            ]
          },
          {
            "label": "ellos, ellas",
            "cells": [
              "u(y)- … -oo'",
              "-oo'"
            ]
          }
        ],
        "note": "«Nosotros» con -e'ex al final incluye a quien escucha: kiwenele'ex «todos dormimos»."
      },
      {
        "type": "pairs",
        "title": "En el pasado, la persona cambia de lugar",
        "description": "En el presente, el juego A marca a quien hace la acción en todos los verbos. En el pasado, los verbos intransitivos usan el juego B al final.",
        "items": [
          {
            "text": "kinwenel",
            "translation": "duermo"
          },
          {
            "text": "weneen",
            "translation": "dormí"
          },
          {
            "text": "kinwilik",
            "translation": "lo veo"
          },
          {
            "text": "tinwilaj",
            "translation": "lo vi"
          }
        ]
      },
      {
        "type": "cards",
        "title": "Tres tipos de verbo",
        "items": [
          {
            "tag": "-Vl",
            "name": "Intransitivo",
            "description": "No lleva objeto. Su sufijo repite la vocal de la raíz: wen-el, jok'-ol, nak'-äl.",
            "examples": [
              {
                "from": "wenel",
                "to": "weneen",
                "meaning": "dormí"
              },
              {
                "from": "k'ochol",
                "to": "k'ocheen",
                "meaning": "llegué"
              }
            ]
          },
          {
            "tag": "-ik",
            "name": "Transitivo de raíz",
            "description": "Lleva objeto. En el pasado toma t- y -aj.",
            "examples": [
              {
                "from": "ilik",
                "to": "tinwilaj",
                "meaning": "lo vi"
              },
              {
                "from": "uk'ik",
                "to": "tinwuk'aj",
                "meaning": "lo bebí"
              }
            ]
          },
          {
            "tag": "-tik",
            "name": "Transitivo con -t",
            "description": "La -t- forma verbos transitivos. En el perfecto la -t- cambia por -m-.",
            "examples": [
              {
                "from": "jantik",
                "to": "tinjantaj",
                "meaning": "lo comí"
              },
              {
                "from": "jantik",
                "to": "injanmaj",
                "meaning": "lo he comido"
              }
            ]
          }
        ]
      },
      {
        "type": "pairs",
        "title": "La negación: ma'",
        "description": "Para negar el presente se usa tan, el marcador de lo que está pasando.",
        "items": [
          {
            "text": "ma' tan inwenel",
            "translation": "no duermo"
          },
          {
            "text": "ma' wenij",
            "translation": "no durmió"
          },
          {
            "text": "ma' tinwilaj",
            "translation": "no lo vi"
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Frases de ejemplo",
        "items": [
          {
            "text": "K'ocheen b'iyeernes.",
            "translation": "Llegué el viernes."
          },
          {
            "text": "Tan uyok'ol a' misoo'ej.",
            "translation": "Los gatos están maullando."
          },
          {
            "text": "Tuyilajoo' juntuul ajchab'.",
            "translation": "Miraron un oso hormiguero."
          },
          {
            "text": "Wi'ijen.",
            "translation": "Tengo hambre."
          },
          {
            "text": "Je' imb'elej!",
            "translation": "¡Sí voy!"
          }
        ]
      }
    ]
  },
