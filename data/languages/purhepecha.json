  "grammar": {
    "intro": "Un verbo p'urhépecha se arma de izquierda a derecha: la raíz y luego, en orden, los sufijos que dicen cómo transcurre la acción, cuándo, si es afirmación o pregunta, y cuántos la hacen.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          { "slot": "Raíz", "description": "El infinitivo sin -ni.", "example": "uanda" },
          { "slot": "Aspecto", "description": "-xa ahora, -sïn de costumbre, -s ya hecho, -xam a punto de.", "example": "-s" },
          { "slot": "Tiempo", "description": "-p- pasado, -a futuro, -pirin condicional; nada en presente.", "example": "-p" },
          { "slot": "Modo", "description": "-ka 1.ª y 2.ª persona, -ti 3.ª; -ki / -pi en preguntas.", "example": "-ti" },
          { "slot": "Plural", "description": "-ksï nosotros y ellos, -jtsï ustedes.", "example": "-ksï" }
        ]
      },
      {
        "type": "table",
        "title": "Las terminaciones del verbo",
        "description": "Se suman a la raíz. Después de m o n, ka y ti se vuelven ga y di: sïn + ka → sïnga.",
        "columns": ["Tiempo", "1.ª y 2.ª", "3.ª", "Pregunta"],
        "rows": [
          { "label": "Presente actual", "cells": ["-xaka", "-xati", "-xaki"] },
          { "label": "Presente habitual", "cells": ["-sïnga", "-sïndi", "-sïni"] },
          { "label": "Presente perfecto", "cells": ["-ska", "-sti", "-ski"] },
          { "label": "Presente incoativo", "cells": ["-xamga", "-xamdi", "-xamki"] },
          { "label": "Pasado actual", "cells": ["-xapka", "-xapti", "-xepi"] },
          { "label": "Pasado habitual", "cells": ["-sïampka", "-sïampti", "-sïambi"] },
          { "label": "Pasado perfecto", "cells": ["-spka", "-spti", "-spi"] },
          { "label": "Pasado incoativo", "cells": ["-xanampka", "-xanampti", "-xanambi"] },
          { "label": "Futuro", "cells": ["-aka", "-ati", "-a"] },
          { "label": "Condicional", "cells": ["-piringa", "-pirindi", "-pirini"] }
        ],
        "note": "Las formas de pregunta valen para todas las personas: ¿uandaxaki? «¿está hablando?», ¿uandaxakiksï? «¿están hablando?»."
      },
      {
        "type": "table",
        "title": "Las personas",
        "description": "Los pronombres casi no se usan: el verbo ya dice quién. Para remarcar al sujeto se usa el pronombre o un clítico pegado al verbo.",
        "columns": ["Persona", "Pronombre", "Clítico", "Ejemplo"],
        "rows": [
          { "label": "yo", "cells": ["ji", "-ni", "uandaxaka(ni)"] },
          { "label": "tú", "cells": ["t'u", "-re", "uandaxaka(re)"] },
          { "label": "él, ella", "cells": ["imá", "—", "uandaxati"] },
          { "label": "nosotros", "cells": ["jucha", "-ksï", "uandaxakaksï"] },
          { "label": "ustedes", "cells": ["cha", "-jtsï", "uandaxakajtsï"] },
          { "label": "ellos, ellas", "cells": ["ts'ïmá", "-ksï", "uandaxatiksï"] }
        ],
        "note": "En el conjugador los clíticos de singular (-ni, -re) no se escriben; los de plural, sí."
      },
      {
        "type": "cards",
        "title": "Cuatro aspectos",
        "description": "Antes que el tiempo, el p'urhépecha dice cómo transcurre la acción. Cada aspecto tiene presente y pasado.",
        "items": [
          { "tag": "-xa", "name": "Actual", "description": "Lo que está pasando en este momento.", "examples": [{ "from": "t'irexaka", "to": "t'irexapka", "meaning": "estoy comiendo · estaba comiendo" }] },
          { "tag": "-sïn", "name": "Habitual", "description": "Lo que se hace de costumbre, o se sabe hacer.", "examples": [{ "from": "uarhasïnga", "to": "uarhasïampka", "meaning": "bailo · bailaba" }] },
          { "tag": "-s", "name": "Perfecto", "description": "Lo que ya se hizo.", "examples": [{ "from": "pireska", "to": "pirespka", "meaning": "he cantado · canté" }] },
          { "tag": "-xam", "name": "Incoativo", "description": "Lo que está a punto de pasar.", "examples": [{ "from": "pirexamga", "to": "pirexanampka", "meaning": "estoy a punto de cantar · estaba a punto de cantar" }] }
        ]
      },
      {
        "type": "pairs",
        "title": "Órdenes",
        "description": "El imperativo es la raíz sola; en plural se le suma -e. Para prohibir se pone ásï antes, nunca «no». Ia agrega «ya, ahora».",
        "items": [
          { "text": "uanda", "translation": "¡habla!" },
          { "text": "uandae", "translation": "¡hablen!" },
          { "text": "ásï uanda", "translation": "¡no hables!" },
          { "text": "ásï t'iree", "translation": "¡no coman!" },
          { "text": "kara ia", "translation": "¡escribe ya!" }
        ]
      },
      {
        "type": "cards",
        "title": "Verbos con futuro irregular",
        "description": "Jarhani, jurhani, nirani y otros cambian rha o ra por u en el futuro, y en el condicional solo conservan la primera sílaba.",
        "items": [
          { "tag": "jarhani", "name": "estar", "description": "Futuro jaua-, condicional ja-.", "examples": [{ "from": "jauaka", "to": "japiringa", "meaning": "estaré · estaría" }] },
          { "tag": "nirani", "name": "ir", "description": "Futuro niua-, condicional ni-.", "examples": [{ "from": "niuaka", "to": "nipiringa", "meaning": "iré · iría" }] },
          { "tag": "jurhani", "name": "venir", "description": "Futuro jua-, condicional ju-.", "examples": [{ "from": "juaka", "to": "jupiringa", "meaning": "vendré · vendría" }] }
        ]
      },
      {
        "type": "pairs",
        "title": "Objeto plural",
        "description": "Cuando lo que recibe la acción es plural, el verbo lleva -a- después de la raíz, y el sustantivo lleva -ni.",
        "items": [
          { "text": "Tsïmi tsikataecha ts'ïrakuaechani t'ireaxati.", "translation": "Estas gallinas están comiendo lombrices." },
          { "text": "Exeauaka achaatiichani.", "translation": "Veré a los señores." },
          { "text": "Exeaue uarharichani.", "translation": "Vean a los danzantes." }
        ]
      },
      {
        "type": "pairs",
        "title": "Frases de ejemplo",
        "items": [
          { "text": "¿Náts'i eranteski?", "translation": "¿Cómo amaneciste?" },
          { "text": "Sési, ¿ka cha?", "translation": "Bien, ¿y usted?" },
          { "text": "Diosï meiamu.", "translation": "Gracias." },
          { "text": "Karla uandasïndi p'urhépecha jimpo.", "translation": "Karla habla en p'urhépecha." },
          { "text": "Ji uekasïnga pireni.", "translation": "Quiero cantar." }
        ]
      }
    ]
