          { "slot": "Derivación", "description": "-chi hacer hacer, -ku para uno mismo, -naku entre varios, -pu para otro, -mu hacia aquí…", "example": "-chi-" },
          { "slot": "Tiempo", "description": "-rqa- pasado, -sqa- pasado no visto, -sha- progresivo…", "example": "-rqa-" },
          { "slot": "Persona", "description": "-ni, -nki, -n, -nchis, -yku, -nkichis, -nku.", "example": "-ni" },
          { "slot": "Enclítico", "description": "-mi lo vi, -si me dijeron, -chá quizá, -chu ¿? / no.", "example": "-mi" }
        ]
      },
