  "grammar": {
    "intro": "Un verbo lacandón se arma con un marcador de aspecto, el pronombre pegado al verbo y un sufijo de estatus que dice si la acción es incompleta, completa o dependiente.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Aspecto",
            "description": "k- incompletivo, t- completivo transitivo; o una palabra aparte: táan, suuk, yaan…",
            "example": "k-"
          },
          {
            "slot": "Juego A",
            "description": "in-, a-, u-, ik- pegado al verbo; ante vocal inw-, aw-, uy-.",
            "example": "inw-"
          },
          {
            "slot": "Verbo",
            "description": "La raíz.",
            "example": "aj"
          },
          {
            "slot": "Estatus",
            "description": "-Vr, -ik, -aj, -ej, -Vk…",
            "example": "-är"
          },
          {
            "slot": "Plural",
            "description": "-e'x, -eche'x, -o'b'.",
            "example": "-o'b'"
          }
        ]
      },
      {
        "type": "table",
        "title": "Dos juegos de pronombres",
        "description": "El juego A va pegado antes del verbo: quién hace la acción. El juego B va al final: el objeto, y el sujeto de los intransitivos en el pasado y el subjuntivo.",
        "columns": [
          "Persona",
          "Juego A",
          "Ante vocal",
          "Juego B"
        ],
        "rows": [
          {
            "label": "yo",
            "cells": [
              "in-",
              "inw-",
              "-en"
            ]
          },
          {
            "label": "tú",
            "cells": [
              "a-",
              "aw-",
              "-ech"
            ]
          },
          {
            "label": "él, ella",
            "cells": [
              "u-",
              "uy-",
              "-ij / —"
            ]
          },
          {
            "label": "nosotros",
            "cells": [
              "ik-",
              "ik'-",
              "-o'n"
            ]
          },
          {
            "label": "ustedes",
            "cells": [
              "a- … -eche'x",
              "aw- … -eche'x",
              "-eche'x"
            ]
          },
          {
            "label": "ellos, ellas",
            "cells": [
              "u- … -o'b'",
              "uy- … -o'b'",
              "-o'b'"
            ]
          }
        ],
        "note": "«Nosotros» con -e'x al final te incluye: kikb'ine'x «vamos (tú y yo)»."
      },
      {
        "type": "cards",
        "title": "Cuatro tipos de verbo",
        "description": "Cada tipo forma su pasado, su subjuntivo y su imperativo de otra manera.",
        "items": [
          {
            "tag": "-Vr",
            "name": "De raíz",
            "description": "Intransitivos que terminan en vocal + r (o n tras nasal); la vocal sigue a la de la raíz.",
            "examples": [
              {
                "from": "weenan",
                "to": "weenech",
                "meaning": "dormiste"
              },
              {
                "from": "b'in",
                "to": "b'inij",
                "meaning": "se fue"
              }
            ]
          },
          {
            "tag": "-n-",
            "name": "De actividad",
            "description": "Verbos como ts'íib, b'eeyaj: -näj en el pasado, -näk en el subjuntivo.",
            "examples": [
              {
                "from": "ts'íib",
                "to": "ts'íibnäj",
                "meaning": "escribió"
              }
            ]
          },
          {
            "tag": "-taar",
            "name": "Posicionales",
            "description": "Cómo queda el cuerpo: -taar mientras pasa, -räj cuando ya pasó.",
            "examples": [
              {
                "from": "kurtaar",
                "to": "kurräj",
                "meaning": "se sentó"
              }
            ]
          },
          {
            "tag": "-ik",
            "name": "Transitivos",
            "description": "-ik mientras pasa, t- … -aj cuando ya pasó, -ej en el subjuntivo y las órdenes.",
            "examples": [
              {
                "from": "ch'äkik",
                "to": "tach'äkaj",
                "meaning": "lo tumbaste"
              }
            ]
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Aspecto, negación y órdenes",
