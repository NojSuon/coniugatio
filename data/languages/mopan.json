  "grammar": {
    "intro": "Un verbo mopán se arma con un marcador de aspecto, el pronombre pegado al verbo y, en los transitivos, un sufijo de estatus: -ik mientras pasa, -aj cuando ya pasó.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Aspecto",
            "description": "walak costumbre, tan en curso, yan tiene que, ka' «que…».",
            "example": "tan"
          },
          {
            "slot": "Juego A",
            "description": "in-, a-, u-, ti- pegado al verbo; ante vocal inw-, aw-, uy-, tiw-.",
            "example": "inw-"
          },
          {
            "slot": "Verbo",
            "description": "La raíz.",
            "example": "il"
          },
          {
            "slot": "Estatus",
            "description": "-ik, -aj, -V' en los transitivos.",
            "example": "-ik"
          },
          {
            "slot": "Plural",
            "description": "-e'ex ustedes, -oo' ellos.",
            "example": "-oo'"
          }
        ]
      },
      {
        "type": "table",
        "title": "Dos juegos de pronombres",
        "description": "El juego A va pegado antes del verbo: quién hace la acción. El juego B va al final: el objeto, y el sujeto de los intransitivos en el pasado y el subjuntivo.",
        "columns": [
          "Persona",
          "Juego A",
          "Ante vocal",
          "Juego B"
        ],
        "rows": [
          {
            "label": "yo",
            "cells": [
              "in-",
              "inw-",
              "-een / -en"
            ]
          },
          {
            "label": "tú",
            "cells": [
              "a-",
              "aw-",
              "-eech / -ech"
            ]
          },
          {
            "label": "él, ella",
            "cells": [
              "u-",
              "uy-",
              "-i / —"
            ]
          },
          {
            "label": "nosotros",
            "cells": [
              "ti-",
              "tiw-",
              "-o'on"
            ]
          },
          {
            "label": "ustedes",
            "cells": [
              "a- … -e'ex",
              "aw- … -e'ex",
              "-e'ex"
            ]
          },
          {
            "label": "ellos, ellas",
            "cells": [
              "u- … -oo'",
              "uy- … -oo'",
              "-oo'"
            ]
          }
        ],
        "note": "«Nosotros» con -e'ex al final incluye a quien escucha: tiwemele'ex «bajamos todos»."
      },
      {
        "type": "cards",
        "title": "Tres maneras de decir «ya pasó»",
        "description": "En el completivo, cada tipo de verbo intransitivo marca a la persona de otra manera.",
        "items": [
          {
            "tag": "-een",
            "name": "De raíz",
            "description": "Verbos en vocal + l que repite la vocal, y tal, beel: la raíz y el juego B.",
            "examples": [
              {
                "from": "emel",
                "to": "emeen",
                "meaning": "bajé"
              },
              {
                "from": "beel",
                "to": "bini",
                "meaning": "se fue"
              }
            ]
          },
          {
            "tag": "uch",
            "name": "De actividad",
            "description": "Verbos como janal, meyaj, ts'iib: uchi «pasó» + el verbo con su pronombre.",
            "examples": [
              {
                "from": "janal",
                "to": "uchi injanal",
                "meaning": "comí"
              }
            ]
          },
          {
            "tag": "-laj",
            "name": "Posicionales",
            "description": "Verbos en -tal que dicen cómo queda el cuerpo.",
            "examples": [
              {
                "from": "jittal",
                "to": "jitlajeen",
                "meaning": "me acosté"
              }
            ]
          }
        ]
      },
      {
        "type": "pairs",
        "title": "Los transitivos",
        "description": "El completivo transitivo no lleva prefijo de aspecto. En el subjuntivo y el imperativo, los de raíz terminan con una vocal que repite la de la raíz; los de -t-, con -e.",
        "items": [
          {
