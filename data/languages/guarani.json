          {
            "slot": "Persona",
            "description": "a-, re-, o-, ja-, ro-, pe-; o che-, nde-, i-…",
            "example": "a-"
          },
          {
            "slot": "Raíz",
            "description": "El verbo sin persona.",
            "example": "japo"
          },
          {
            "slot": "Tiempo y modo",
            "description": "-ta futuro, -kuri pasado, -se querer, -ma ya…",
            "example": "-mo'ã"
          },
          {
            "slot": "Negación",
            "description": "-i (-ri tras i).",
            "example": "-i"
          }
        ]
      },
      {
