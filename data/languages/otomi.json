    "notes": [
      "De las vocales nasales, solo la ä se escribe. La ë, la ï y la ü existen en la lengua, pero normalmente no se marcan.",
      "El saltillo va después de ch, k, t y ts (k'eñä), y antes de b, m, n, ñ, r, u e y ('ba, 'ñu).",
      "Los tonos no se escriben en las palabras. En los proclíticos del verbo, el tono alto se marca con tilde porque cambia el significado: dí xipi «yo le digo», di xipi «él le dice».",
      "La pronunciación aparece entre corchetes con el Alfabeto Fonético Internacional (AFI). La u suena [w] antes de otra vocal: ua «pie». La x suena como «sh» [ʃ] y la j, como la j del español [x]."
    ]
  },
  "grammar": {
    "intro": "Para conjugar un verbo en hñähñu, pon un proclítico antes de la raíz. El proclítico dice quién hace la acción y cuándo.",
    "formula": [
      {
        "slot": "Proclítico",
        "description": "Persona y tiempo. Con hin- delante, la frase es negativa.",
        "example": "bi"
      },
      {
        "slot": "Raíz",
        "description": "El verbo. En el pretérito y el futuro puede cambiar su primera letra.",
        "example": "bädi"
      },
      {
        "slot": "Plural",
        "description": "Sufijo -hu̱ para «nosotros» y «ustedes».",
        "example": "-hu̱"
      }
    ],
    "tone_pairs": [
      {
        "text": "dí xipi",
        "translation": "yo le digo"
      },
      {
        "text": "di xipi",
        "translation": "él le dice"
      },
      {
        "text": "dá xipi",
        "translation": "yo le dije"
      },
      {
        "text": "da xipi",
        "translation": "él le dirá"
      },
      {
        "text": "gá xipi",
        "translation": "tú le dijiste"
      },
      {
        "text": "ga xipi",
        "translation": "yo le diré"
      }
    ],
    "root_changes": {
      "intro": "En el pretérito y el futuro, muchas raíces cambian su primera consonante. Así se forman las formas secundarias de la raíz.",
      "rules": [
        {
          "name": "Forma B",
          "where": "3.ª persona",
          "description": "La consonante se vuelve sonora: p → b, t → d, th → d, ts → z, k → g, j → g, f → m.",
          "examples": [
            {
              "from": "pädi",
              "to": "bi bädi",
              "meaning": "lo supo"
            },
            {
              "from": "tai",
              "to": "bi dai",
              "meaning": "lo compró"
            },
            {
              "from": "ku̱ni",
              "to": "bi gu̱ni",
              "meaning": "lo molió"
            }
          ]
        },
        {
          "name": "Forma Y",
          "where": "2.ª y 3.ª persona",
          "description": "Si la raíz empieza con vocal o con h + vocal, se agrega y (o ñ si la vocal es nasal).",
          "examples": [
            {
              "from": "honi",
              "to": "bi hyoni",
              "meaning": "lo buscó"
            },
            {
              "from": "'o̱de",
              "to": "bi 'yo̱de",
              "meaning": "lo oyó"
            },
            {
              "from": "'ähä",
              "to": "bi 'ñähä",
              "meaning": "durmió"
            }
          ]
        },
        {
          "name": "Forma N",
          "where": "todas las personas",
          "description": "Algunos verbos no cambian su consonante, pero suman n- (o m-). El diccionario lo indica con la 1.ª persona del pretérito.",
          "examples": [
            {
              "from": "sagi",
              "to": "dá nsagi",
              "meaning": "brinqué"
            },
            {
              "from": "thede",
              "to": "bi nthede",
              "meaning": "se rio"
            },
            {
              "from": "tsithe",
              "to": "dá ntsithe",
              "meaning": "tomé agua"
            }
          ]
        }
      ]
    },
    "plural": {
      "description": "En el habla de todos los días, el sufijo -hu̱ cambia el final de la raíz:",
      "examples": [
        {
          "from": "tsi",
          "to": "tsihu̱",
          "meaning": "beber"
        },
        {
          "from": "pe̱fi",
          "to": "pe̱hu̱",
          "meaning": "trabajar"
        },
        {
          "from": "handi",
          "to": "hanthu̱",
          "meaning": "mirar"
        },
        {
          "from": "beni",
          "to": "beñhu̱",
          "meaning": "pensar"
        },
        {
          "from": "tai",
          "to": "tañhu̱",
          "meaning": "comprar"
        }
      ]
    },
    "predicate": {
      "description": "Para decir «soy», «eres» o «es» con un sustantivo, el proclítico se une al artículo ra.",
      "tenses": [
        {
          "name": "Presente",
          "forms": [
            "drá",
            "grá",
            "ra"
          ]
        },
        {
          "name": "Copretérito",
          "forms": [
            "ndrá",
            "ngrá",
            "mrá"
          ]
        },
        {
          "name": "Futuro",
          "forms": [
            "gra",
            "gra",
            "dra"
          ]
        }
      ],
      "example": {
        "text": "Drá hñähñu.",
        "translation": "Soy hñähñu."
      }
    },
    "examples": [
      {
        "text": "Drí nxadi ra hñämfo̱.",
        "translation": "Estoy estudiando español."
      },
      {
        "text": "Dí ähä 'nihi.",
        "translation": "Me duermo temprano."
      },
      {
        "text": "Pe hingi nei.",
        "translation": "Pero no baila."
      },
      {
        "text": "Nuga hindá handi.",
        "translation": "Yo no lo vi."
      },
      {
        "text": "Xá mädi.",
        "translation": "Está caro."
      }
    ]
  },
