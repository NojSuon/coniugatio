  "grammar": {
    "intro": "Para conjugar un verbo en hñähñu, pon un proclítico antes de la raíz. El proclítico dice quién hace la acción y cuándo.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Proclítico",
            "description": "Persona y tiempo. Con hin- delante, la frase es negativa.",
            "example": "bi"
          },
          {
            "slot": "Raíz",
            "description": "El verbo. En el pretérito y el futuro puede cambiar su primera letra.",
            "example": "bädi"
          },
          {
            "slot": "Plural",
            "description": "Sufijo -hu̱ para «nosotros» y «ustedes».",
            "example": "-hu̱"
          }
        ]
      },
      {
        "type": "pairs",
        "title": "El tono del proclítico cambia el significado",
        "description": "Fíjate en la tilde: marca un tono alto.",
        "items": [
          {
            "text": "dí xipi",
            "translation": "yo le digo"
          },
          {
            "text": "di xipi",
            "translation": "él le dice"
          },
          {
            "text": "dá xipi",
            "translation": "yo le dije"
          },
          {
            "text": "da xipi",
            "translation": "él le dirá"
          },
          {
            "text": "gá xipi",
            "translation": "tú le dijiste"
          },
          {
            "text": "ga xipi",
            "translation": "yo le diré"
          }
        ]
      },
      {
        "type": "cards",
        "title": "La raíz también cambia",
        "description": "En el pretérito y el futuro, muchas raíces cambian su primera consonante. Así se forman las formas secundarias de la raíz.",
        "items": [
          {
            "tag": "3.ª persona",
            "name": "Forma B",
            "description": "La consonante se vuelve sonora: p → b, t → d, th → d, ts → z, k → g, j → g, f → m.",
            "examples": [
              {
                "from": "pädi",
                "to": "bi bädi",
                "meaning": "lo supo"
              },
              {
                "from": "tai",
                "to": "bi dai",
                "meaning": "lo compró"
              },
              {
                "from": "ku̱ni",
                "to": "bi gu̱ni",
                "meaning": "lo molió"
              }
            ]
          },
          {
            "tag": "2.ª y 3.ª persona",
            "name": "Forma Y",
            "description": "Si la raíz empieza con vocal o con h + vocal, se agrega y (o ñ si la vocal es nasal).",
            "examples": [
              {
                "from": "honi",
                "to": "bi hyoni",
                "meaning": "lo buscó"
              },
              {
                "from": "'o̱de",
                "to": "bi 'yo̱de",
                "meaning": "lo oyó"
              },
              {
                "from": "'ähä",
                "to": "bi 'ñähä",
                "meaning": "durmió"
              }
            ]
          },
          {
            "tag": "todas las personas",
            "name": "Forma N",
            "description": "Algunos verbos no cambian su consonante, pero suman n- (o m-). El diccionario lo indica con la 1.ª persona del pretérito.",
            "examples": [
              {
                "from": "sagi",
                "to": "dá nsagi",
                "meaning": "brinqué"
              },
              {
                "from": "thede",
                "to": "bi nthede",
                "meaning": "se rio"
              },
              {
                "from": "tsithe",
                "to": "dá ntsithe",
                "meaning": "tomé agua"
              }
            ]
          }
        ]
      },
      {
