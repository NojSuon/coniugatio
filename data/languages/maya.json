  "grammar": {
    "intro": "Un verbo maya se arma con un marcador de aspecto, un pronombre y el verbo. Los transitivos llevan además un sufijo de estatus: -ik mientras pasa, -aj cuando ya pasó, -ej para lo que aún no es.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          { "slot": "Aspecto", "description": "k- costumbre, táan en curso, ts'o'ok ya, yaan tiene que…", "example": "k-" },
          { "slot": "Pronombre (juego A)", "description": "Quién lo hace: in, a, u, k.", "example": "in" },
          { "slot": "Verbo", "description": "El verbo; con vocal inicial suma w- o y-: in w-il-ik.", "example": "xok" },
          { "slot": "Estatus", "description": "-ik, -aj, -ej en los transitivos.", "example": "-ik" },
          { "slot": "Plural", "description": "-e'ex ustedes, -o'ob ellos.", "example": "-o'ob" }
        ]
      },
      {
        "type": "table",
        "title": "Dos juegos de pronombres",
        "description": "El juego A va antes del verbo y marca a quien hace la acción. El juego B va al final: marca al objeto, y al sujeto en el completivo intransitivo y el futuro con bíin.",
        "columns": ["Persona", "Juego A", "Ante vocal", "Juego B"],
        "rows": [
          { "label": "yo", "cells": ["in", "in w-", "-en"] },
          { "label": "tú", "cells": ["a", "a w-", "-ech"] },
          { "label": "él, ella", "cells": ["u", "u y-", "-ij / —"] },
          { "label": "nosotros", "cells": ["k", "k", "-o'on"] },
          { "label": "ustedes", "cells": ["a … -e'ex", "a w- … -e'ex", "-e'ex"] },
          { "label": "ellos, ellas", "cells": ["u … -o'ob", "u y- … -o'ob", "-o'ob"] }
        ],
        "note": "El aspecto k- (costumbre) se une al pronombre: k + in → kin, k + a → ka, k + u → ku."
      },
      {
        "type": "cards",
        "title": "Tres maneras de decir «ya pasó»",
        "description": "En el completivo, los intransitivos usan el juego B y su forma depende del tipo de verbo.",
        "items": [
          { "tag": "j- … -en", "name": "De raíz", "description": "Verbos en vocal + l que repite la vocal de la raíz, y los de movimiento. La vocal corta se alarga.", "examples": [{ "from": "wenel", "to": "jweenen", "meaning": "dormí" }, { "from": "bin", "to": "jbinen", "meaning": "me fui" }] },
          { "tag": "-naj-", "name": "De actividad", "description": "Verbos como janal, meyaj, báaxal.", "examples": [{ "from": "janal", "to": "janalnajen", "meaning": "comí" }, { "from": "meyaj", "to": "meyajnajech", "meaning": "trabajaste" }] },
          { "tag": "-laj-", "name": "Posicionales", "description": "Verbos en -tal que dicen cómo queda el cuerpo.", "examples": [{ "from": "kultal", "to": "kullajen", "meaning": "me senté" }] }
        ]
      },
      {
        "type": "pairs",
        "title": "Los transitivos: -ik, -aj, -ej",
        "description": "El completivo transitivo lleva t- unido al pronombre. El futuro con bíin lleva -ej, que solo se escribe en singular y al final de la frase.",
        "items": [
          { "text": "kin xokik", "translation": "lo leo" },
          { "text": "tin xokaj", "translation": "lo leí" },
          { "text": "bíin in xokej", "translation": "algún día lo leeré" },
          { "text": "ts'o'ok u xokik", "translation": "ya lo leyó" },
          { "text": "xokej", "translation": "¡léelo!" }
        ]
      },
      {
        "type": "pairs",
        "title": "Auxiliares",
        "description": "Palabras que van antes del pronombre y agregan un sentido.",
        "items": [
          { "text": "taak in janal", "translation": "quiero comer" },
          { "text": "k'a'abet in janal", "translation": "necesito comer" },
          { "text": "yaan in janal", "translation": "tengo que comer" },
          { "text": "suuk in janal", "translation": "acostumbro comer" },
          { "text": "jo'op' in janal", "translation": "empecé a comer" },
          { "text": "táant in janale'", "translation": "acabo de comer" }
        ]
      },
      {
        "type": "pairs",
        "title": "Órdenes y negación",
        "description": "El imperativo intransitivo termina en -en o -nen; el transitivo, en -ej. Ma' niega y la frase suele cerrar con -i'.",
        "items": [
          { "text": "xooknen", "translation": "¡estudia!" },
          { "text": "xeen", "translation": "¡vete!" },
          { "text": "kóoten", "translation": "¡ven!" },
          { "text": "ma' a wenel", "translation": "¡no duermas!" },
          { "text": "ma' tin wojéeltiki'", "translation": "no lo sé" }
        ]
      },
      {
        "type": "pairs",
        "title": "Frases de ejemplo",
        "items": [
          { "text": "Bix a beel?", "translation": "¿Cómo estás?" },
          { "text": "Ma'alob, kux teech?", "translation": "Bien, ¿y tú?" },
          { "text": "Jach Dios bo'otik.", "translation": "Muchas gracias." },
          { "text": "Ba'ax a k'aaba'?", "translation": "¿Cómo te llamas?" },
          { "text": "Táan in kanik maayat'aan.", "translation": "Estoy aprendiendo maya." }
        ]
      }
    ]
