  "grammar": {
    "intro": "伊察语的动词由几个部分组成：有时有一个助词，然后是体标记、人称前缀、动词和状态后缀。查动词时，请按词典的写法输入：wenel「睡觉」，ilik「看」。",
    "blocks": [
      {
        "items": [
          {
            "slot": "助词",
            "description": "可选的词，增加一层意思：k'abet「需要」，tak「想」。"
          },
          {
            "slot": "体",
            "description": "动作在什么时候、以什么方式发生：k- 表示习惯，tan 表示正在。"
          },
          {
            "slot": "人称（A 组）",
            "description": "谁做这个动作。"
          },
          {
            "slot": "动词",
            "description": "词根。"
          },
          {
            "slot": "状态",
            "description": "随体而变的后缀：-el、-ik、-aj……"
          },
          {
            "slot": "复数",
            "description": "-e'ex 表示「你们」，-o' 表示「他们」。"
          }
        ]
      },
      {
        "title": "两组人称标记",
        "description": "A 组放在动词前面；B 组放在后面。在元音前，A 组加上 w 或 y：in-w-il，u-y-il。",
        "columns": [
          "人称",
          "A 组",
          "B 组"
        ],
        "rows": [
          {
            "label": "我"
          },
          {
            "label": "你"
          },
          {
            "label": "他，她"
          },
          {
            "label": "我们"
          },
          {
            "label": "你们"
          },
          {
            "label": "他们"
          }
        ],
        "note": "「我们」后面加上 -e'ex 就包括听话的人：kiwenele'ex「我们大家睡觉」。"
      },
      {
        "title": "在过去时中，人称会移位",
        "description": "在现在时中，所有动词都用 A 组表示谁做动作。在过去时中，不及物动词把 B 组放在末尾。",
        "items": [
          {
            "translation": "我睡觉"
          },
          {
            "translation": "我睡了"
          },
          {
            "translation": "我看它"
          },
          {
            "translation": "我看了它"
          }
        ]
      },
      {
        "title": "三种动词",
        "items": [
          {
            "name": "不及物",
            "description": "没有宾语。它的后缀重复词根的元音：wen-el，jok'-ol，nak'-äl。",
            "examples": [
              {
                "meaning": "我睡了"
              },
              {
                "meaning": "我到了"
              }
            ]
          },
          {
            "name": "词根及物动词",
            "description": "带宾语。在过去时中加上 t- 和 -aj。",
            "examples": [
              {
                "meaning": "我看了它"
              },
              {
                "meaning": "我喝了它"
              }
            ]
          },
          {
            "name": "带 -t 的及物动词",
            "description": "-t- 用来构成及物动词。在完成时中 -t- 变成 -m-。",
            "examples": [
              {
                "meaning": "我吃了它"
              },
              {
                "meaning": "我已经吃了它"
              }
            ]
          }
        ]
      },
      {
        "title": "助词",
        "description": "它们放在动词前面，动词保留人称前缀和 -Vl 或 -ik 后缀，但不带 k-。",
        "items": [
          {
            "translation": "我需要睡觉"
          },
          {
            "translation": "我想睡觉"
          },
          {
            "translation": "我得睡觉"
          },
          {
            "translation": "我能睡觉"
          },
          {
            "translation": "我常常睡觉"
          },
          {
            "translation": "我差点睡着了"
          },
          {
            "translation": "我开始睡觉了"
          },
          {
            "translation": "我已经睡了"
          }
        ]
      },
      {
        "title": "语气：依附状态",
        "description": "表示还不是现实的事（愿望、命令、警告）时，动词用依附状态：不及物动词用 -Vk，及物动词用 -V' 或 -ej。",
        "items": [
          {
            "name": "虚拟式",
            "description": "「让……」：可能发生也可能不发生的事。",
            "examples": [
              {
                "meaning": "让你睡觉"
              },
              {
                "meaning": "让他/她喝它"
              }
            ]
          },
          {
            "name": "命令式",
            "description": "命令。否定时，ma' 与现在时连用。",
            "examples": [
              {
                "meaning": "睡吧！"
              },
              {
                "meaning": "别睡！"
              }
            ]
          },
          {
            "name": "警告",
            "description": "提醒可能发生的事。",
            "examples": [
              {
                "meaning": "小心，你可能会摔倒！"
              }
            ]
          },
          {
            "name": "劝勉式",
            "description": "「我们……吧」。用 ko'on 表示「来……」。",
            "examples": [
              {
                "meaning": "我们睡吧"
              },
              {
                "meaning": "我们看看它吧"
              }
            ]
          }
        ]
      },
      {
        "title": "否定：ma'",
        "description": "否定现在时要用 tan，也就是表示正在发生的标记。",
        "items": [
          {
            "translation": "我不睡觉"
          },
          {
            "translation": "他/她没睡"
          },
          {
            "translation": "我没看见它"
          }
        ]
      },
      {
