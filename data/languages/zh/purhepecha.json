          },
          {
            "slot": "时态",
            "description": "-p- 过去时，-a 将来时，-pirin 条件式；现在时什么都不加。"
          },
          {
            "slot": "语气",
            "description": "-ka 第一和第二人称，-ti 第三人称；疑问句中用 -ki / -pi。"
          },
          {
            "slot": "复数",
            "description": "-ksï 我们和他们，-jtsï 你们。"
          }
        ]
      },
