  "grammar": {
    "intro": "纳瓦特尔语的动词由词根前后的前缀和后缀构成：谁做、对谁做、什么时候、多少人。",
    "blocks": [
      {
        "items": [
          {
            "slot": "过去",
            "description": "o- 表示过去时。"
          },
          {
            "slot": "主语",
            "description": "ni- 我，ti- 你或我们，an- 你们。"
          },
          {
            "slot": "宾语",
            "description": "ki-「它」，tla-「某物」，te-「某人」，mo- 反身。"
          },
          {
            "slot": "动词",
            "description": "词根。"
          },
          {
            "slot": "时态和复数",
            "description": "-s 将来时，-ya 未完成过去时，-j / -kej 复数。"
          }
        ]
      },
      {
        "title": "主语和宾语前缀",
        "description": "第三人称没有主语前缀。ti- 是「你」或「我们」：复数在末尾加 -j。",
        "columns": [
          "人称",
          "主语",
          "宾语",
          "反身"
        ],
        "rows": [
          {
            "label": "我"
          },
