  "grammar": {
    "intro": "玛雅语的动词由体标记、代词和动词构成。及物动词还带一个状态后缀：正在发生时用 -ik，已经发生用 -aj，还不是现实的事用 -ej。",
    "blocks": [
      {
        "items": [
          {
            "slot": "体",
            "description": "k- 习惯，táan 正在，ts'o'ok 已经，yaan 必须……"
          },
          {
            "slot": "代词（A 组）",
            "description": "谁做：in、a、u、k。"
          },
          {
            "slot": "动词",
            "description": "动词；如果以元音开头就加 w- 或 y-：in w-il-ik。"
          },
          {
            "slot": "状态",
            "description": "及物动词中的 -ik、-aj、-ej。"
          },
          {
            "slot": "复数",
            "description": "-e'ex 你们，-o'ob 他们。"
          }
        ]
      },
      {
