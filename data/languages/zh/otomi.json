  "grammar": {
    "intro": "要为 Hñähñu 的动词变位，就在词根前加一个前附词。前附词表示谁做这个动作，以及什么时候做。",
    "blocks": [
      {
        "items": [
          {
            "slot": "前附词",
            "description": "人称和时态。前面加上 hin-，句子就变成否定。"
          },
          {
            "slot": "词根",
            "description": "动词本身。在过去时和将来时中，它的第一个字母可能会变。"
          },
          {
            "slot": "复数",
            "description": "后缀 -hu̱ 表示「我们」和「你们」。"
          }
        ]
      },
      {
        "title": "前附词的声调会改变意思",
        "description": "注意重音符号：它表示高调。",
        "items": [
          {
            "translation": "我告诉他/她"
          },
          {
            "translation": "他/她告诉他/她"
          },
          {
            "translation": "我告诉了他/她"
          },
          {
            "translation": "他/她会告诉他/她"
          },
          {
            "translation": "你告诉了他/她"
          },
          {
            "translation": "我会告诉他/她"
          }
        ]
      },
      {
        "title": "词根也会变化",
        "description": "在过去时和将来时中，许多词根会改变首辅音。词根的次要形式就是这样构成的。",
        "items": [
          {
            "name": "B 形式",
            "description": "辅音变成浊音：p → b，t → d，th → d，ts → z，k → g，j → g，f → m。",
            "examples": [
              {
                "meaning": "他/她知道了"
              },
              {
                "meaning": "他/她买了它"
              },
              {
                "meaning": "他/她磨了它"
              }
            ]
          },
          {
            "name": "Y 形式",
            "description": "如果词根以元音或 h + 元音开头，就加上 y（如果元音是鼻元音，就加 ñ）。",
            "examples": [
              {
                "meaning": "他/她找了它"
              },
              {
                "meaning": "他/她听到了"
              },
              {
                "meaning": "他/她睡了"
              }
            ]
          },
          {
            "name": "N 形式",
            "description": "有些动词保留辅音，但加上 n-（或 m-）。词典用过去时的第一人称标出。",
            "examples": [
              {
                "meaning": "我跳了"
              },
              {
                "meaning": "他/她笑了"
              },
              {
                "meaning": "我喝了水"
              }
            ]
          }
        ]
      },
      {
        "blocks": [
          {
            "title": "带 -hu̱ 的复数",
            "description": "在日常口语中，后缀 -hu̱ 会改变词根的结尾：",
            "examples": [
              {
                "meaning": "喝"
              },
              {
                "meaning": "工作"
              },
              {
                "meaning": "看"
              },
              {
                "meaning": "想"
              },
              {
                "meaning": "买"
              }
            ]
          },
          {
            "title": "表示「是」：前附词 + ra",
            "description": "要用名词说「我是」「你是」「他/她是」，前附词要和冠词 ra 连在一起。",
            "columns": [
              "时态",
              "第一人称",
              "第二人称",
              "第三人称"
            ],
            "rows": [
              {
                "label": "现在时"
              },
              {
                "label": "未完成过去时"
              },
              {
                "label": "将来时"
              }
            ]
          }
        ]
      },
      {
