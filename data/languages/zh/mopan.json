  "grammar": {
    "intro": "莫潘语的动词由体标记、和动词连写的代词，以及及物动词的状态后缀构成：正在发生时用 -ik，已经发生用 -aj。",
    "blocks": [
      {
        "items": [
          {
            "slot": "体",
            "description": "walak 习惯，tan 正在，yan 必须，ka'「让……」。"
          },
          {
            "slot": "A 组",
            "description": "in-、a-、u-、ti- 和动词连写；元音前为 inw-、aw-、uy-、tiw-。"
          },
          {
            "slot": "动词",
            "description": "词根。"
          },
          {
            "slot": "状态",
            "description": "及物动词中的 -ik、-aj、-V'。"
          },
          {
            "slot": "复数",
            "description": "-e'ex 你们，-oo' 他们。"
          }
        ]
      },
      {
        "title": "两组代词",
        "description": "A 组连写在动词前面：谁做这个动作。B 组放在末尾：宾语，以及过去时和虚拟式中不及物动词的主语。",
        "columns": [
          "人称",
          "A 组",
          "元音前",
          "B 组"
        ],
        "rows": [
          {
            "label": "我"
          },
