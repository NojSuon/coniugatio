  "grammar": {
    "intro": "拉坎冬语的动词由体标记、和动词连写的代词，以及表示动作未完成、已完成或依附的状态后缀构成。",
    "blocks": [
      {
        "items": [
          {
            "slot": "体",
            "description": "k- 未完成体，t- 及物完成体；或者一个独立的词：táan、suuk、yaan……"
          },
          {
            "slot": "A 组",
            "description": "in-、a-、u-、ik- 和动词连写；元音前为 inw-、aw-、uy-。"
          },
          {
            "slot": "动词",
            "description": "词根。"
          },
          {
            "slot": "状态",
            "description": "-Vr、-ik、-aj、-ej、-Vk……"
          },
          {
            "slot": "复数",
            "description": "-e'x、-eche'x、-o'b。"
          }
        ]
      },
      {
        "title": "两组代词",
