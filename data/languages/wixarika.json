  "grammar": {
    "intro": "Un verbo wixárika pone casi todo antes de la raíz: quién lo hace, la certeza del hablante, a quién, dónde y cuántas veces. Después de la raíz van el tiempo y el aspecto.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          {
            "slot": "Sujeto",
            "description": "ne- yo, pe- tú, — él/ella; te- nosotros, xe- ustedes, me- ellos.",
            "example": "ne-"
          },
          {
            "slot": "Aserción",
            "description": "pɨ- lo que se afirma aquí y ahora; mɨ- lo narrado; ka- niega.",
            "example": "pɨ-"
          },
          {
            "slot": "Prefijos",
            "description": "ta- / ti- singular o plural, u- visible, e- lejos, ka- abajo, ti- arriba…",
            "example": "ti-"
          },
          {
            "slot": "Raíz",
            "description": "Cambia en algunos verbos según el número o el aspecto.",
            "example": "'uximaya"
          },
          {
            "slot": "Tiempo",
            "description": "-kai imperfecto, -xɨ perfectivo, -ni futuro, -ne / -tɨwe progresivo.",
            "example": "-kai"
          }
        ]
      },
