        "rows": [
          { "label": "nocka «I»" },
          { "label": "ckam «you»" },
          { "label": "pay «he, she»" },
          { "label": "nockanchis «we (with you)»" },
          { "label": "nockaycu «we (not you)»" },
          { "label": "ckamcuna «you all»" },
          { "label": "paycuna «they»" }
        ]
      },
      {
        "title": "Roots in -i and -u",
