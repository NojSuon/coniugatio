  "grammar": {
    "intro": "A Lacandon verb is built from an aspect marker, the pronoun joined to the verb and a status suffix that says whether the action is incomplete, complete or dependent.",
    "blocks": [
      {
        "items": [
          {
            "slot": "Aspect",
            "description": "k- incompletive, t- transitive completive; or a separate word: táan, suuk, yaan…"
          },
          {
            "slot": "Set A",
            "description": "in-, a-, u-, ik- joined to the verb; before a vowel inw-, aw-, uy-."
          },
          {
            "slot": "Verb",
            "description": "The root."
          },
          {
            "slot": "Status",
            "description": "-Vr, -ik, -aj, -ej, -Vk…"
          },
          {
            "slot": "Plural",
            "description": "-e'x, -eche'x, -o'b."
          }
        ]
      },
      {
        "title": "Two sets of pronouns",
        "description": "Set A goes before the verb: who does the action. Set B goes at the end: the object, and the subject of intransitive verbs in the past and the subjunctive.",
        "columns": [
          "Person",
          "Set A",
          "Before a vowel",
          "Set B"
        ],
        "rows": [
          {
            "label": "I"
          },
          {
            "label": "you"
          },
          {
            "label": "he, she"
          },
          {
            "label": "we"
          },
          {
            "label": "you all"
          },
          {
            "label": "they"
          }
        ],
        "note": "«We» with -e'x at the end includes you: kikbine'x «we go (you and I)»."
      },
      {
        "title": "Four kinds of verb",
        "description": "Each kind makes its past, subjunctive and imperative in its own way.",
        "items": [
          {
            "name": "Root",
            "description": "Intransitives ending in a vowel + r (or n after a nasal); the vowel follows the root's.",
            "examples": [
              {
                "meaning": "you slept"
              },
              {
                "meaning": "s/he went"
              }
            ]
          },
          {
            "name": "Activity",
            "description": "Verbs like ts'íib, beeyaj: -näj in the past, -näk in the subjunctive.",
            "examples": [
              {
                "meaning": "s/he wrote"
              }
            ]
          },
          {
            "name": "Positionals",
            "description": "How the body ends up: -taar while it happens, -räj once it happened.",
            "examples": [
              {
                "meaning": "s/he sat down"
              }
            ]
          },
          {
            "name": "Transitive",
            "description": "-ik while it happens, t- … -aj once it happened, -ej in the subjunctive and orders.",
            "examples": [
              {
                "meaning": "you chopped it down"
              }
            ]
          }
        ]
      },
      {
        "title": "Aspect, negation and orders",
        "description": "Ma' negates; with the incompletive it becomes ma' t-. Táan, suuk and the other markers go apart, and the verb starts with a glottal stop.",
