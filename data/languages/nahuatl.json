  "grammar": {
    "intro": "Un verbo náhuatl se arma con prefijos y sufijos alrededor de la raíz: quién lo hace, a quién, cuándo y cuántos.",
    "blocks": [
      {
        "type": "formula",
        "items": [
          { "slot": "Pasado", "description": "o- marca el pretérito.", "example": "o-" },
          { "slot": "Sujeto", "description": "ni- yo, ti- tú o nosotros, an- ustedes.", "example": "ni-" },
          { "slot": "Objeto", "description": "ki- «lo», tla- «algo», te- «a alguien», mo- reflexivo.", "example": "k-" },
          { "slot": "Verbo", "description": "La raíz.", "example": "chiua" },
          { "slot": "Tiempo y plural", "description": "-s futuro, -ya copretérito, -j / -kej plural.", "example": "-s" }
        ]
      },
      {
        "type": "table",
        "title": "Prefijos de sujeto y de objeto",
        "description": "La 3.ª persona no lleva prefijo de sujeto. Ti- es «tú» o «nosotros»: el plural lleva -j al final.",
        "columns": ["Persona", "Sujeto", "Objeto", "Reflexivo"],
        "rows": [
          { "label": "yo", "cells": ["ni-", "nech-", "no-"] },
          { "label": "tú", "cells": ["ti-", "mits-", "mo-"] },
          { "label": "él, ella", "cells": ["—", "ki-", "mo-"] },
          { "label": "nosotros", "cells": ["ti- … -j", "tech-", "to-"] },
          { "label": "ustedes", "cells": ["an- … -j", "amech-", "mo-"] },
          { "label": "ellos, ellas", "cells": ["— … -j", "kin-", "mo-"] }
        ],
        "note": "Ki- se vuelve k- después de una vocal: ni + ki + chiua → nikchiua."
      },
      {
        "type": "cards",
        "title": "Cuatro clases de verbos en el pasado",
        "description": "Cada verbo forma su pasado de una de cuatro maneras. Todos llevan o- al principio.",
        "items": [
          { "tag": "Clase 1", "name": "Suma -k", "description": "Verbos que terminan en dos consonantes + vocal, y algunos otros.", "examples": [{ "from": "pano", "to": "opanok", "meaning": "pasó" }, { "from": "tsajtsi", "to": "otsajtsik", "meaning": "gritó" }] },
          { "tag": "Clase 2", "name": "Pierde la vocal final", "description": "La clase más común. La m final se vuelve n.", "examples": [{ "from": "tlachiua", "to": "otlachiu", "meaning": "hizo" }, { "from": "nemi", "to": "onen", "meaning": "vivió" }] },
          { "tag": "Clase 3", "name": "-ia, -oa → -j", "description": "Pierden la a final y suman -j.", "examples": [{ "from": "tlâjtoa", "to": "otlâjtoj", "meaning": "habló" }] },
          { "tag": "Clase 4", "name": "Suma -j", "description": "Pocos verbos, como kua «comer».", "examples": [{ "from": "tlakua", "to": "otlakuaj", "meaning": "comió" }] }
        ]
      },
      {
        "type": "pairs",
        "title": "Las vocales que se funden",
        "description": "Cuando un prefijo con vocal se junta con un verbo que empieza con i, la i desaparece y la otra vocal lleva circunflejo.",
        "items": [
          { "text": "tla + ijtoa → tlâjtoa", "translation": "hablar" },
          { "text": "tla + ijkuiloa → tlâjkuiloa", "translation": "escribir" },
          { "text": "to + itta → tôtta", "translation": "nos vemos" },
          { "text": "no + iknitl → nôkniu", "translation": "mi hermano" }
        ]
      },
      {
        "type": "pairs",
        "title": "Los modos",
        "description": "Con ma se piden cosas; con xi- se da una orden a «tú» o «ustedes»; amo niega.",
        "items": [
          { "text": "xikchiua", "translation": "¡hazlo!" },
          { "text": "xikchiuakan", "translation": "¡háganlo!" },
          { "text": "ma nikchiua", "translation": "que yo lo haga" },
          { "text": "amo xikchiua", "translation": "¡no lo hagas!" },
          { "text": "ma tiuets", "translation": "¡cuidado, no te caigas!" }
        ]
      },
      {
        "type": "pairs",
        "title": "Frases de ejemplo",
        "items": [
          { "text": "Ken tinemi?", "translation": "¿Cómo estás?" },
          { "text": "Tlen tikchiua?", "translation": "¿Qué haces?" },
          { "text": "Tlen opanok?", "translation": "¿Qué pasó?" },
          { "text": "Nipaki nimitsixmatis.", "translation": "Me alegra conocerte." },
          { "text": "Tôttaskej.", "translation": "Nos vemos." }
        ]
      }
    ]
  },
